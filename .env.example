# CraveDrop Supabase Production Backend Configuration
# Replace these values with your actual Supabase Project URL & Anon Public Key
# Found in: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Optional Cloudflare R2 / Storage bucket configuration
VITE_R2_ENDPOINT=https://crave-media.r2.cloudflarestorage.com
VITE_R2_BUCKET_NAME=cravedrop-media
VITE_R2_PUBLIC_URL=https://media.cravedrop.food
